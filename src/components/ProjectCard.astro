---
import type { ProjectEntry } from "../data/site";

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const Tag = project.href ? "a" : "div";
const linkProps = project.href
  ? { href: project.href, target: "_blank", rel: "noopener noreferrer" }
  : {};
---

<Tag
  {...linkProps}
  class="group flex flex-col gap-3 rounded-2xl border border-[var(--border)] p-6 transition-colors hover:bg-[var(--bg-elevated)]"
>
  <div class="flex items-start justify-between gap-4">
    <h3 class="font-semibold">{project.title}</h3>
    {
      project.href ? (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          class="h-4 w-4 shrink-0 text-[var(--fg-muted)] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        >
          <path d="M7 17L17 7M7 7h10v10" />
        </svg>
      ) : (
        <span class="shrink-0 rounded-full border border-[var(--border)] px-2.5 py-0.5 text-xs text-[var(--fg-muted)]">
          Private
        </span>
      )
    }
  </div>
  <p class="text-sm text-[var(--fg-muted)]">{project.description}</p>
  <div class="mt-2 flex flex-wrap items-center gap-2">
    {
      project.tags.map((tag) => (
        <span class="rounded-full border border-[var(--border)] px-3 py-1 text-xs text-[var(--fg-muted)]">
          {tag}
        </span>
      ))
    }
    {
      project.packagist && (
        <img
          src={`https://img.shields.io/packagist/dt/${project.packagist}?style=flat-square&logo=packagist&logoColor=white&label=downloads&color=F28D1A`}
          alt="Packagist downloads"
          class="h-5"
          loading="lazy"
        />
      )
    }
  </div>
</Tag>
