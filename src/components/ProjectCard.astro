---
import type { ProjectEntry } from "../data/site";
import { visibilityLabel } from "../lib/labels";

interface Props {
  project: ProjectEntry;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;

const payload = JSON.stringify({
  title: project.title,
  description: project.description,
  keyRole: project.keyRole,
  contributions: project.contributions,
  tags: project.tags,
  href: project.href,
  visibility: visibilityLabel[project.visibility],
});

const tagLimit = featured ? project.tags.length : 4;
const shownTags = project.tags.slice(0, tagLimit);
const hiddenTagCount = project.tags.length - shownTags.length;
const host = project.href ? new URL(project.href).hostname.replace(/^www\./, "") : null;
---

<article
  data-visibility={project.visibility}
  class:list={[
    "project-card group relative flex flex-col rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)] transition-[border-color,box-shadow] duration-200 hover:border-[var(--border-strong)] hover:shadow-[var(--shadow)]",
    featured ? "p-6 sm:p-8 md:col-span-2" : "p-6",
  ]}
>
  <div class="flex flex-wrap items-center gap-2 text-xs">
    <span
      class:list={[
        "rounded-full px-2.5 py-0.5 font-medium",
        project.visibility === "open-source"
          ? "bg-[var(--teal-soft)] text-[var(--teal)]"
          : "border border-[var(--border)] text-[var(--fg-muted)]",
      ]}
    >
      {visibilityLabel[project.visibility]}
    </span>
    <span class="text-[var(--fg-faint)]">{project.keyRole}</span>
  </div>

  <h3
    class:list={[
      "mt-4 font-display font-semibold leading-tight tracking-tight",
      featured ? "text-2xl sm:text-3xl" : "text-xl",
    ]}
  >
    {project.title}
  </h3>

  <p class:list={["mt-3 text-[var(--fg-muted)]", featured ? "max-w-[68ch]" : "line-clamp-4 text-sm"]}>
    {project.description}
  </p>

  <div class="mt-5 flex flex-wrap items-center gap-1.5">
    {shownTags.map((tag) => <span class="chip">{tag}</span>)}
    {hiddenTagCount > 0 && <span class="chip text-[var(--fg-faint)]">+{hiddenTagCount}</span>}
  </div>

  <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-6">
    <button
      type="button"
      data-project={payload}
      class="inline-flex items-center gap-2 rounded-md text-sm font-medium text-[var(--fg)] after:absolute after:inset-0 after:rounded-xl after:content-['']"
    >
      <span class="link-underline">What I built</span>
      <span class="rounded bg-[var(--bg-sunken)] px-1.5 py-0.5 font-mono text-xs text-[var(--fg-muted)]">
        {project.contributions.length}
      </span>
    </button>

    <div class="relative z-10 flex items-center gap-3">
      {
        project.packagist && (
          <a href={`https://packagist.org/packages/${project.packagist}`} target="_blank" rel="noopener noreferrer">
            <img
              src={`https://img.shields.io/packagist/dt/${project.packagist}?style=flat-square&logo=packagist&logoColor=white&label=downloads&color=F28D1A`}
              alt="Packagist downloads"
              class="h-5"
              loading="lazy"
            />
          </a>
        )
      }
      {
        host && (
          <a
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-sm text-[var(--fg-muted)] transition-colors hover:text-[var(--teal)]"
          >
            {host}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-3.5 w-3.5" aria-hidden="true">
              <path d="M7 17 17 7M8 7h9v9" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</article>
