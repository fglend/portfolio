---
import type { ProjectEntry } from "../data/site";

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;

const payload = JSON.stringify({
  title: project.title,
  description: project.description,
  keyRole: project.keyRole,
  contributions: project.contributions,
  tags: project.tags,
  href: project.href,
});
---

<button
  type="button"
  data-project={payload}
  class="group flex w-full flex-col gap-3 rounded-2xl border border-[var(--border)] p-6 text-left transition-colors hover:bg-[var(--bg-elevated)]"
>
  <div class="flex items-start justify-between gap-4">
    <h3 class="font-semibold">{project.title}</h3>
    {
      !project.href && (
        <span class="shrink-0 rounded-full border border-[var(--border)] px-2.5 py-0.5 text-xs text-[var(--fg-muted)]">
          Private
        </span>
      )
    }
  </div>
  <p class="text-sm text-[var(--fg-muted)]">{project.description}</p>
  <div class="mt-2 flex flex-wrap items-center gap-2">
    {
      project.tags.map((tag) => (
        <span class="rounded-full border border-[var(--border)] px-3 py-1 text-xs text-[var(--fg-muted)]">
          {tag}
        </span>
      ))
    }
    {
      project.packagist && (
        <img
          src={`https://img.shields.io/packagist/dt/${project.packagist}?style=flat-square&logo=packagist&logoColor=white&label=downloads&color=F28D1A`}
          alt="Packagist downloads"
          class="h-5"
          loading="lazy"
        />
      )
    }
  </div>
  <span class="mt-1 inline-flex items-center gap-1.5 text-sm font-medium text-[var(--fg-muted)] transition-colors group-hover:text-[var(--fg)]">
    View details
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5">
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  </span>
</button>
