---
import { profile } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border)]">
  <div class="mx-auto flex max-w-4xl flex-col items-center gap-4 px-6 py-10 text-sm text-[var(--fg-muted)] sm:flex-row sm:justify-between">
    <p>&copy; {year} {profile.name}. All rights reserved.</p>
    <div class="flex items-center gap-5">
      <a href={profile.social.github} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--fg)]">
        GitHub
      </a>
      <a href={profile.social.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--fg)]">
        LinkedIn
      </a>
      <a href={`mailto:${profile.email}`} class="hover:text-[var(--fg)]"> Email </a>
    </div>
  </div>
</footer>
