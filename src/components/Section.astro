---
interface Props {
  id: string;
  title: string;
  /** Short factual note under the title, e.g. a count or date range. */
  meta?: string;
}

const { id, title, meta } = Astro.props;
---

<section id={id} class="scroll-mt-20 border-t border-[var(--border)]">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-16 sm:px-6 md:grid-cols-[220px_1fr] md:gap-12 md:py-24 lg:grid-cols-[260px_1fr]">
    <header class="md:sticky md:top-24 md:self-start">
      <h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
      {meta && <p class="mt-2 text-sm text-[var(--fg-faint)]">{meta}</p>}
    </header>
    <div class="min-w-0">
      <slot />
    </div>
  </div>
</section>
