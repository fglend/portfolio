---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
}

const { id, eyebrow, title } = Astro.props;
---

<section id={id} class="mx-auto max-w-4xl scroll-mt-24 px-6 py-16 md:py-20">
  <div class="mb-10 flex flex-col gap-2">
    <p class="section-heading">{eyebrow}</p>
    <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{title}</h2>
  </div>
  <slot />
</section>
