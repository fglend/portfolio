---
// Single shared modal, populated at click-time from the triggering card's
// data-project attribute. Rendered once by Projects.astro.
---

<dialog
  id="project-modal"
  class="w-[calc(100%-2rem)] max-w-lg rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-0 text-[var(--fg)] backdrop:bg-black/50 backdrop:backdrop-blur-sm"
>
  <div class="flex items-start justify-between gap-4 border-b border-[var(--border)] p-6">
    <h3 id="project-modal-title" class="text-lg font-semibold"></h3>
    <button
      type="button"
      id="project-modal-close"
      aria-label="Close"
      class="grid h-8 w-8 shrink-0 place-items-center rounded-full text-[var(--fg-muted)] transition-colors hover:bg-[var(--bg)]"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="flex max-h-[70vh] flex-col gap-5 overflow-y-auto p-6">
    <div>
      <p class="section-heading">Description</p>
      <p id="project-modal-description" class="mt-2 text-sm text-[var(--fg-muted)]"></p>
    </div>

    <div>
      <p class="section-heading">Key Role</p>
      <p id="project-modal-role" class="mt-2 text-sm"></p>
    </div>

    <div>
      <p class="section-heading">What I Developed</p>
      <ul id="project-modal-contributions" class="mt-2 flex flex-col gap-2 text-sm text-[var(--fg-muted)]"></ul>
    </div>

    <div id="project-modal-tags" class="flex flex-wrap gap-2"></div>

    <a
      id="project-modal-link"
      target="_blank"
      rel="noopener noreferrer"
      class="mt-1 inline-flex w-fit items-center gap-2 rounded-full bg-[var(--fg)] px-5 py-2.5 text-sm font-medium text-[var(--bg)] transition-opacity hover:opacity-85"
    >
      View project
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-3.5 w-3.5">
        <path d="M7 17L17 7M7 7h10v10" />
      </svg>
    </a>
  </div>
</dialog>

<script>
  type ProjectModalPayload = {
    title: string;
    description: string;
    keyRole: string;
    contributions: string[];
    tags: string[];
    href?: string;
  };

  const dialog = document.getElementById("project-modal") as HTMLDialogElement | null;
  const titleEl = document.getElementById("project-modal-title");
  const descriptionEl = document.getElementById("project-modal-description");
  const roleEl = document.getElementById("project-modal-role");
  const contributionsEl = document.getElementById("project-modal-contributions");
  const tagsEl = document.getElementById("project-modal-tags");
  const linkEl = document.getElementById("project-modal-link") as HTMLAnchorElement | null;
  const closeBtn = document.getElementById("project-modal-close");

  function openModal(data: ProjectModalPayload) {
    if (!dialog || !titleEl || !descriptionEl || !roleEl || !contributionsEl || !tagsEl || !linkEl) return;

    titleEl.textContent = data.title;
    descriptionEl.textContent = data.description;
    roleEl.textContent = data.keyRole;

    contributionsEl.innerHTML = "";
    data.contributions.forEach((point) => {
      const li = document.createElement("li");
      li.className = "flex gap-2";
      li.innerHTML = `<span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-[var(--fg-muted)]"></span><span></span>`;
      (li.lastElementChild as HTMLElement).textContent = point;
      contributionsEl.appendChild(li);
    });

    tagsEl.innerHTML = "";
    data.tags.forEach((tag) => {
      const span = document.createElement("span");
      span.className = "rounded-full border border-[var(--border)] px-3 py-1 text-xs text-[var(--fg-muted)]";
      span.textContent = tag;
      tagsEl.appendChild(span);
    });

    if (data.href) {
      linkEl.href = data.href;
      linkEl.hidden = false;
    } else {
      linkEl.hidden = true;
    }

    dialog.showModal();
  }

  document.querySelectorAll<HTMLButtonElement>("[data-project]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const raw = trigger.dataset.project;
      if (!raw) return;
      openModal(JSON.parse(raw));
    });
  });

  closeBtn?.addEventListener("click", () => dialog?.close());

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
