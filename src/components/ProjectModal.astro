---
// Single shared modal, populated at click-time from the triggering card's
// data-project attribute. Rendered once by Projects.astro.
---

<dialog
  id="project-modal"
  aria-labelledby="project-modal-title"
  class="w-[calc(100%-2rem)] max-w-2xl overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)] p-0 text-[var(--fg)] shadow-[var(--shadow)] backdrop:bg-[#06100f]/60 backdrop:backdrop-blur-sm"
>
  <div class="flex max-h-[85vh] flex-col">
    <header class="flex items-start justify-between gap-4 border-b border-[var(--border)] p-6">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span id="project-modal-visibility" class="rounded-full bg-[var(--teal-soft)] px-2.5 py-0.5 font-medium text-[var(--teal)]"></span>
          <span id="project-modal-role" class="text-[var(--fg-muted)]"></span>
        </div>
        <h3 id="project-modal-title" class="mt-3 font-display text-2xl font-semibold leading-tight tracking-tight"></h3>
      </div>
      <button
        type="button"
        id="project-modal-close"
        aria-label="Close project details"
        class="grid h-9 w-9 shrink-0 place-items-center rounded-md border border-[var(--border)] text-[var(--fg-muted)] transition-colors hover:text-[var(--fg)]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </header>

    <div class="flex flex-col gap-8 overflow-y-auto overscroll-contain p-6">
      <p id="project-modal-description" class="max-w-[68ch] text-[var(--fg-muted)]"></p>

      <div>
        <h4 class="flex items-baseline gap-2 font-display text-lg font-semibold">
          What I built
          <span id="project-modal-count" class="font-sans text-sm font-normal text-[var(--fg-faint)]"></span>
        </h4>
        <ul id="project-modal-contributions" class="mt-4 flex flex-col gap-3 text-[15px] text-[var(--fg-muted)]"></ul>
      </div>

      <div>
        <h4 class="font-display text-lg font-semibold">Stack</h4>
        <div id="project-modal-tags" class="mt-3 flex flex-wrap gap-1.5"></div>
      </div>
    </div>

    <footer id="project-modal-footer" class="flex justify-end border-t border-[var(--border)] bg-[var(--bg-sunken)] px-6 py-4">
      <a
        id="project-modal-link"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-md bg-[var(--fg)] px-4 py-2 text-sm font-medium text-[var(--bg)] transition-opacity hover:opacity-85"
      >
        Open project
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-3.5 w-3.5" aria-hidden="true">
          <path d="M7 17 17 7M8 7h9v9" />
        </svg>
      </a>
    </footer>
  </div>
</dialog>

<style>
  dialog#project-modal {
    position: fixed;
    inset: 0;
    margin: auto;
    opacity: 0;
    transform: translateY(12px) scale(0.98);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      overlay 0.2s ease allow-discrete,
      display 0.2s ease allow-discrete;
  }
  dialog#project-modal[open] {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    dialog#project-modal[open] {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }
  dialog#project-modal::backdrop {
    opacity: 0;
    transition: opacity 0.2s ease allow-discrete;
  }
  dialog#project-modal[open]::backdrop {
    opacity: 1;
  }
  @starting-style {
    dialog#project-modal[open]::backdrop {
      opacity: 0;
    }
  }
</style>

<script>
  type ProjectModalPayload = {
    title: string;
    description: string;
    keyRole: string;
    contributions: string[];
    tags: string[];
    href?: string;
    visibility: string;
  };

  const $ = (id: string) => document.getElementById(id);
  const dialog = $("project-modal") as HTMLDialogElement | null;
  const linkEl = $("project-modal-link") as HTMLAnchorElement | null;
  const footerEl = $("project-modal-footer");

  function openModal(data: ProjectModalPayload) {
    if (!dialog || !linkEl || !footerEl) return;

    $("project-modal-title")!.textContent = data.title;
    $("project-modal-description")!.textContent = data.description;
    $("project-modal-role")!.textContent = data.keyRole;
    $("project-modal-visibility")!.textContent = data.visibility;
    $("project-modal-count")!.textContent = `${data.contributions.length} items`;

    const list = $("project-modal-contributions")!;
    list.replaceChildren(
      ...data.contributions.map((point) => {
        const li = document.createElement("li");
        li.className = "flex gap-3";
        const mark = document.createElement("span");
        mark.className = "mt-[0.7em] h-px w-3 shrink-0 bg-[var(--teal)]";
        mark.setAttribute("aria-hidden", "true");
        const text = document.createElement("span");
        text.textContent = point;
        li.append(mark, text);
        return li;
      }),
    );

    $("project-modal-tags")!.replaceChildren(
      ...data.tags.map((tag) => {
        const span = document.createElement("span");
        span.className = "chip";
        span.textContent = tag;
        return span;
      }),
    );

    if (data.href) {
      linkEl.href = data.href;
      footerEl.hidden = false;
    } else {
      footerEl.hidden = true;
    }

    dialog.showModal();
    dialog.querySelector(".overflow-y-auto")?.scrollTo(0, 0);
  }

  document.querySelectorAll<HTMLButtonElement>("[data-project]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const raw = trigger.dataset.project;
      if (raw) openModal(JSON.parse(raw));
    });
  });

  $("project-modal-close")?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
