---
import Section from "./Section.astro";
import { education } from "../data/site";
---

<Section id="education" title="Education" meta={`${education.length} degrees`}>
  <div class="grid gap-4 lg:grid-cols-2">
    {
      education.map((entry) => (
        <article class="flex flex-col rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)] p-6">
          <div class="flex items-start justify-between gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-6 w-6 text-[var(--teal)]" aria-hidden="true">
              <path d="M2 9.5 12 5l10 4.5-10 4.5L2 9.5Z" />
              <path d="M6 11.3V16c0 1.4 2.7 3 6 3s6-1.6 6-3v-4.7M22 9.5V15" />
            </svg>
            <span class="font-mono text-sm text-[var(--fg-muted)]">{entry.period.replace(" - ", " — ")}</span>
          </div>
          <h3 class="mt-5 font-display text-xl font-semibold leading-snug">{entry.degree}</h3>
          <p class="mt-1 text-[var(--fg-muted)]">{entry.school}</p>
          {entry.details && (
            <p class="mt-4 border-t border-[var(--border)] pt-4 text-sm text-[var(--fg-muted)]">{entry.details}</p>
          )}
        </article>
      ))
    }
  </div>
</Section>
