---
import Section from "./Section.astro";
import { education } from "../data/site";
---

<Section id="education" eyebrow="Background" title="Education">
  <div class="grid gap-6 sm:grid-cols-2">
    {
      education.map((entry) => (
        <div class="rounded-2xl border border-[var(--border)] p-6">
          <p class="text-sm text-[var(--fg-muted)]">{entry.period}</p>
          <h3 class="mt-1 font-semibold">{entry.degree}</h3>
          <p class="text-sm text-[var(--fg-muted)]">{entry.school}</p>
          {entry.details && <p class="mt-3 text-sm text-[var(--fg-muted)]">{entry.details}</p>}
        </div>
      ))
    }
  </div>
</Section>
