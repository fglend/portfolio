---
import Section from "./Section.astro";
import { experience } from "../data/site";
---

<Section id="experience" eyebrow="Career" title="Experience">
  <ol class="flex flex-col gap-10">
    {
      experience.map((job) => (
        <li class="grid gap-2 md:grid-cols-[180px_1fr] md:gap-8">
          <div class="text-sm text-[var(--fg-muted)]">{job.period}</div>
          <div>
            <h3 class="font-semibold">
              {job.role} <span class="text-[var(--fg-muted)] font-normal">· {job.company}</span>
            </h3>
            {job.location && <p class="mt-0.5 text-sm text-[var(--fg-muted)]">{job.location}</p>}
            <ul class="mt-3 flex flex-col gap-2">
              {job.highlights.map((point) => (
                <li class="flex gap-2 text-sm text-[var(--fg-muted)]">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-[var(--fg-muted)]" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
