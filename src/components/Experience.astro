---
import Section from "./Section.astro";
import { experience } from "../data/site";

const years = experience.map((job) => job.period.split(/[—-]/).map((s) => s.trim()));
const span = `${years.at(-1)?.[0] ?? ""} to ${years[0]?.[1] ?? ""}`;
---

<Section id="experience" title="Experience" meta={`${experience.length} roles, ${span}`}>
  <ol class="relative">
    {
      experience.map((job, i) => (
        <li class="group relative grid gap-3 pb-12 pl-8 last:pb-0 md:grid-cols-[140px_1fr] md:gap-8 md:pl-0">
          {/* Timeline rail: the dot sits on the line, the line stops at the last entry. */}
          <span
            class="absolute left-[5px] top-2 bottom-0 w-px bg-[var(--border)] md:left-[155px] group-last:hidden"
            aria-hidden="true"
          />
          <span
            class:list={[
              "absolute left-0 top-1.5 h-[11px] w-[11px] rounded-full border-2 md:left-[150px]",
              i === 0 ? "border-[var(--teal)] bg-[var(--teal)]" : "border-[var(--border-strong)] bg-[var(--bg)]",
            ]}
            aria-hidden="true"
          />

          <div class="md:pr-6 md:text-right">
            <p class="font-mono text-sm text-[var(--fg-muted)]">{job.period}</p>
            {i === 0 && <p class="mt-1 text-xs font-medium text-[var(--teal)]">Current</p>}
          </div>

          <div class="md:pl-8">
            <h3 class="font-display text-xl font-semibold leading-tight">{job.role}</h3>
            <p class="mt-1 text-[var(--fg-muted)]">
              {job.company}
              {job.location && <span class="text-[var(--fg-faint)]">, {job.location}</span>}
            </p>
            <ul class="mt-4 flex max-w-[68ch] flex-col gap-2.5">
              {job.highlights.map((point) => (
                <li class="flex gap-3 text-[var(--fg-muted)]">
                  <span class="mt-[0.7em] h-px w-3 shrink-0 bg-[var(--border-strong)]" aria-hidden="true" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
