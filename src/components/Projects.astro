---
import Section from "./Section.astro";
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../data/site";

const openSource = projects.filter((p) => p.visibility === "open-source");
const privateProjects = projects.filter((p) => p.visibility === "private");
const personalProjects = projects.filter((p) => p.visibility === "personal");
---

<Section id="projects" eyebrow="Projects" title="Projects I've built">
  <div class="flex flex-col gap-12">
    {
      openSource.length > 0 && (
        <div>
          <h3 class="mb-4 text-sm font-medium text-[var(--fg-muted)]">Open Source</h3>
          <div class="grid gap-6">
            {openSource.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      )
    }
    {
      privateProjects.length > 0 && (
        <div>
          <h3 class="mb-4 text-sm font-medium text-[var(--fg-muted)]">Private</h3>
          <div class="grid gap-6">
            {privateProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      )
    }
    {
      personalProjects.length > 0 && (
        <div>
          <h3 class="mb-4 text-sm font-medium text-[var(--fg-muted)]">Personal</h3>
          <div class="grid gap-6">
            {personalProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      )
    }
  </div>
</Section>
