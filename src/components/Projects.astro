---
import Section from "./Section.astro";
import ProjectCard from "./ProjectCard.astro";
import { visibilityLabel } from "../lib/labels";
import ProjectModal from "./ProjectModal.astro";
import { projects, type ProjectVisibility } from "../data/site";

const order: ProjectVisibility[] = ["open-source", "private", "personal"];
const filters = [
  { value: "all", label: "All", count: projects.length },
  ...order
    .map((v) => ({ value: v, label: visibilityLabel[v], count: projects.filter((p) => p.visibility === v).length }))
    .filter((f) => f.count > 0),
];

const sorted = [...projects].sort((a, b) => order.indexOf(a.visibility) - order.indexOf(b.visibility));
const featuredTitle = sorted.find((p) => p.visibility === "open-source")?.title;
---

<Section id="projects" title="Projects" meta="Open the details on any card for the full list of what I built">
  <div role="group" aria-label="Filter projects" class="mb-6 flex flex-wrap gap-1.5">
    {
      filters.map((f, i) => (
        <button
          type="button"
          data-filter={f.value}
          aria-pressed={i === 0 ? "true" : "false"}
          class="inline-flex items-center gap-2 rounded-md border border-[var(--border)] px-3 py-1.5 text-sm text-[var(--fg-muted)] transition-colors hover:text-[var(--fg)] aria-pressed:border-[var(--fg)] aria-pressed:bg-[var(--fg)] aria-pressed:text-[var(--bg)]"
        >
          {f.label}
          <span class="font-mono text-xs opacity-70">{f.count}</span>
        </button>
      ))
    }
  </div>

  <div id="project-grid" class="grid gap-4 md:grid-cols-2">
    {sorted.map((project) => <ProjectCard project={project} featured={project.title === featuredTitle} />)}
  </div>

  <ProjectModal />
</Section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>(".project-card");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      cards.forEach((card) => {
        card.hidden = filter !== "all" && card.dataset.visibility !== filter;
      });
    });
  });
</script>
