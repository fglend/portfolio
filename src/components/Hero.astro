---
import { profile, experience, education, projects } from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const current = experience[0];
const latestDegree = education[0];
const openSource = projects.find((p) => p.visibility === "open-source");
const shortCompany = (name: string) =>
  name.replace("University of the Philippines - Los Baños", "UP Los Baños");

// The hero panel reads like a Kafka consumer tailing a topic: each record is a
// fact about me, pulled from site.ts so it never drifts from the rest of the page.
const records = [
  { key: "role", value: `${current.role}, ${shortCompany(current.company)}` },
  { key: "focus", value: "Backend services, REST APIs, event-driven integrations" },
  { key: "experience", value: `4+ years across ${experience.length} roles` },
  ...(openSource?.packagist ? [{ key: "oss.package", value: openSource.packagist }] : []),
  { key: "projects", value: `${projects.length} shipped, from Kafka plugins to lake monitoring` },
  { key: "education", value: latestDegree.degree.replace("Master of Science in", "MS") },
  { key: "location", value: profile.location },
];
---

<section id="top" class="relative overflow-hidden">
  <div class="grid-backdrop pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 pb-20 pt-32 sm:px-6 md:pt-40 lg:grid-cols-[1.1fr_1fr] lg:gap-16 lg:pb-28">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--bg-elevated)] py-1 pl-2 pr-3 text-sm text-[var(--fg-muted)]">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--teal)] opacity-60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--teal)]"></span>
        </span>
        {profile.role} in Los Baños, {profile.location}
      </p>

      <h1 class="mt-6 font-display text-[clamp(2.75rem,8vw,5.5rem)] font-bold leading-[0.95] tracking-[-0.035em]">
        {profile.name}
      </h1>

      <p class="mt-6 max-w-xl font-display text-xl leading-snug text-[var(--fg)] sm:text-2xl">
        {profile.tagline}
      </p>

      <p class="mt-4 max-w-xl text-[var(--fg-muted)]">
        {profile.summary}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 rounded-md bg-[var(--fg)] px-5 py-2.5 text-sm font-medium text-[var(--bg)] transition-opacity hover:opacity-85"
        >
          See projects
        </a>
        <a
          href={`${base}/resume.docx`}
          download
          class="inline-flex items-center gap-2 rounded-md border border-[var(--border-strong)] bg-[var(--bg-elevated)] px-5 py-2.5 text-sm font-medium transition-colors hover:border-[var(--teal)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4" aria-hidden="true">
            <path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14" />
          </svg>
          Download resume
        </a>
        <div class="flex items-center gap-1 pl-1">
          <a
            href={profile.social.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub profile"
            class="grid h-10 w-10 place-items-center rounded-md text-[var(--fg-muted)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--fg)]"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.82 1.19 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
          </a>
          <a
            href={profile.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn profile"
            class="grid h-10 w-10 place-items-center rounded-md text-[var(--fg-muted)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--fg)]"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0Z"/></svg>
          </a>
        </div>
      </div>

      <a href="https://hub.xerj.org/contributors/fglend" target="_blank" rel="noopener noreferrer" class="mt-6 inline-block w-fit">
        <img src="https://hub.xerj.org/contributors/fglend/badge.svg" alt="XERJ Corpus Hub contributor" loading="lazy" />
      </a>
    </div>

    <!-- Consumer panel -->
    <figure
      class="overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)] shadow-[var(--shadow)]"
      aria-label="Profile summary, styled as records consumed from a message topic"
    >
      <div class="flex items-center justify-between gap-3 border-b border-[var(--border)] px-4 py-3">
        <div class="flex min-w-0 items-center gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0 text-[var(--teal)]" aria-hidden="true">
            <path d="M4 6h16M4 12h10M4 18h6" />
          </svg>
          <span class="truncate font-mono text-[13px] font-medium">glend.profile</span>
          <span class="hidden text-xs text-[var(--fg-faint)] sm:inline">partition 0</span>
        </div>
        <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[var(--teal-soft)] px-2 py-0.5 text-xs font-medium text-[var(--teal)]">
          <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
          Consuming
        </span>
      </div>

      <div class="grid grid-cols-[3rem_6.5rem_1fr] border-b border-[var(--border)] bg-[var(--bg-sunken)] px-4 py-2 text-xs text-[var(--fg-faint)] max-sm:grid-cols-[3.25rem_1fr]">
        <span>Offset</span>
        <span class="max-sm:hidden">Key</span>
        <span class="max-sm:hidden">Value</span>
        <span class="sm:hidden">Record</span>
      </div>

      <ol class="divide-y divide-[var(--border)]">
        {
          records.map((record, i) => (
            <li
              class="record grid grid-cols-[3rem_6.5rem_1fr] items-baseline px-4 py-3 text-sm max-sm:grid-cols-[3.25rem_1fr]"
              style={`--i:${i}`}
            >
              <span class="font-mono text-xs text-[var(--amber)]">{String(i).padStart(3, "0")}</span>
              <span class="font-mono text-xs text-[var(--fg-muted)] max-sm:hidden">{record.key}</span>
              <span class="min-w-0">
                <span class="mb-0.5 block font-mono text-[11px] text-[var(--fg-faint)] sm:hidden">{record.key}</span>
                {record.value}
              </span>
            </li>
          ))
        }
      </ol>

      <figcaption class="flex items-center justify-between border-t border-[var(--border)] px-4 py-2.5 text-xs text-[var(--fg-faint)]">
        <span>{records.length} records</span>
        <span>Lag 0</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  /* The one orchestrated motion on the page: records arrive in offset order. */
  .record {
    animation: record-in 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(350ms + var(--i) * 140ms);
  }
  @keyframes record-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
      background-color: var(--amber-soft);
    }
    60% {
      opacity: 1;
      transform: none;
      background-color: var(--amber-soft);
    }
    to {
      opacity: 1;
      transform: none;
      background-color: transparent;
    }
  }
</style>
