---
import { profile } from "../data/site";
---

<section id="top" class="mx-auto flex max-w-4xl flex-col justify-center gap-6 px-6 pb-24 pt-40 min-h-screen md:min-h-[90vh]">
  <p class="section-heading">{profile.role}</p>

  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
    Hi, I'm {profile.name.split(" ")[0]}.
    <span class="block text-[var(--fg-muted)]">{profile.tagline}</span>
  </h1>

  <p class="max-w-xl text-base text-[var(--fg-muted)] sm:text-lg">
    {profile.summary}
  </p>

  <div class="mt-4 flex flex-wrap items-center gap-4">
    <a
      href="#experience"
      class="rounded-full bg-[var(--fg)] px-6 py-3 text-sm font-medium text-[var(--bg)] transition-opacity hover:opacity-85"
    >
      View my work
    </a>
    <a
      href={`mailto:${profile.email}`}
      class="rounded-full border border-[var(--border)] px-6 py-3 text-sm font-medium transition-colors hover:bg-[var(--bg-elevated)]"
    >
      Get in touch
    </a>
    <a
      href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/resume.docx`}
      download
      class="rounded-full border border-[var(--border)] px-6 py-3 text-sm font-medium transition-colors hover:bg-[var(--bg-elevated)]"
    >
      Download Resume
    </a>
  </div>
</section>
