---
import Section from "./Section.astro";
import { techStack } from "../data/site";
---

<Section id="stack" eyebrow="Toolbox" title="Tech Stack">
  <div class="grid gap-8 sm:grid-cols-2">
    {
      techStack.map((group) => (
        <div>
          <h3 class="mb-3 text-sm font-medium text-[var(--fg-muted)]">{group.category}</h3>
          <div class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <span class="rounded-full bg-[var(--bg-elevated)] border border-[var(--border)] px-3 py-1.5 text-sm">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Section>
