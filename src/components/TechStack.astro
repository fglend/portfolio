---
import Section from "./Section.astro";
import { techStack, projects } from "../data/site";

// How many projects on this page use each tool, so the stack is backed by evidence.
const usage = (item: string) =>
  projects.filter((p) => p.tags.some((t) => t.toLowerCase().includes(item.toLowerCase()))).length;

const total = techStack.reduce((n, g) => n + g.items.length, 0);
---

<Section id="stack" title="Tech stack" meta={`${total} tools I use day to day`}>
  <div class="grid gap-px overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--border)] sm:grid-cols-2 xl:grid-cols-3">
    {
      techStack.map((group) => (
        <div class="bg-[var(--bg-elevated)] p-5">
          <h3 class="font-display text-base font-semibold">{group.category}</h3>
          <ul class="mt-3 flex flex-col">
            {group.items.map((item) => {
              const count = usage(item);
              return (
                <li class="flex items-baseline justify-between gap-3 border-t border-dashed border-[var(--border)] py-2 first:border-t-0">
                  <span>{item}</span>
                  {count > 0 && (
                    <span class="shrink-0 text-xs text-[var(--fg-faint)]">
                      {count} {count === 1 ? "project" : "projects"}
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
